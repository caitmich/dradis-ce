<%= form_with(model: @tag, url: [@project, @tag]) do |f| %>
  <div class="form-group">
    <%= f.label :name %>
    <%= f.text_field :name, value: (@tag.persisted? ? @tag.display_name : '') %>

    <%= f.label :color %>
    <%= f.text_field :color, value: @color, placeholder: "6-digit hex code" %>
  </div>
  <div class="form-group mb-0 pt-1">
    <%= submit_tag @tag.persisted? ? "Update" : "Create", class: "btn btn-primary mt-4", data: { behavior: "animate-click" } %>
  </div>
<% end %>
